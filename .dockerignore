# VCS
**/.git

# Node & Python dependencies (rebuilt inside the image; never copy the host's)
**/node_modules
**/.venv

# Build outputs (regenerated by the client-build stage)
client/dist
**/tsconfig.tsbuildinfo

# Dev databases, seeded data & uploads (recreated + seeded at runtime)
**/*.db
server/src/zapp_atlas/db/data

# Secrets & local environment
**/.env

# Python & tooling caches
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
